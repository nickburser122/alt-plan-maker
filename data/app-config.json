{
  "dataset": "data/complete_data.json",
  "datasetLabel": "data/complete_data.json",
  "autoCheck": true,
  "ruleTemplates": [
    {
      "label": { "en": "Women: at most 1 per basic visit", "ar": "السيدات: واحدة على الأكثر لكل زيارة أساسية" },
      "rule": { "rel": "team", "sense": "prefer", "what": { "k": "cat", "v": "basic" }, "op": "max", "n": 1, "who": { "k": "gender", "v": "f" }, "w": 50 }
    },
    {
      "label": { "en": "Critical places: at least 1 rank ≥ 75", "ar": "الأماكن الحرجة: عضو تصنيفه ≥ 75 على الأقل" },
      "rule": { "rel": "team", "sense": "only", "what": { "k": "critGe", "v": "100" }, "op": "min", "n": 1, "who": { "k": "rankGe", "v": "75" }, "w": 60 }
    },
    {
      "label": { "en": "Avoid far places (≥ 70 km)", "ar": "تجنّب الأماكن البعيدة (≥ 70 كم)" },
      "rule": { "rel": "site", "sense": "avoid", "who": { "k": "all", "v": "" }, "what": { "k": "kmGe", "v": "70" }, "w": 40 }
    },
    {
      "label": { "en": "Someone never goes to a location", "ar": "شخص لا يذهب أبداً إلى موقع" },
      "rule": { "rel": "site", "sense": "never", "who": { "k": "person", "v": "" }, "what": { "k": "loc", "v": "" }, "w": 50 }
    },
    {
      "label": { "en": "Someone prefers a category", "ar": "شخص يفضّل فئة" },
      "rule": { "rel": "site", "sense": "prefer", "who": { "k": "person", "v": "" }, "what": { "k": "cat", "v": "contracted" }, "w": 50 }
    },
    {
      "label": { "en": "Nobody works on a weekday", "ar": "لا أحد يعمل يوماً معيّناً" },
      "rule": { "rel": "day", "sense": "never", "who": { "k": "all", "v": "" }, "what": { "k": "dow", "v": [false, false, false, false, false, true, false] }, "w": 50 }
    },
    {
      "label": { "en": "Two juniors avoid pairing", "ar": "مبتدئان لا يعملان معاً" },
      "rule": { "rel": "with", "sense": "avoid", "who": { "k": "rankLe", "v": "25" }, "what": { "k": "rankLe", "v": "25" }, "w": 50 }
    }
  ]
}
